class Wizard {}
var gandalf = Wizard();

gandalf.color = "Grey";
gandalf.power = nil;
print gandalf.color;

// functions should be able to accept class
// instances and get or set properties on them
fun promote(wizard) {

  if (true) {
    wizard.power = 100;
    wizard.color = "White";
  } else {
    wizard.power = 0;
  }
}

promote(gandalf);
print gandalf.color;
print gandalf.power;